{
  "name": "dsh-sidebar-remote",
  "version": "0.2.0",
  "description": "DSH Web 聚合插件：自动集成 dsh-better-sidebar 与 @dsh-ssh/dsh-ssh，使 SSH 远程工作区的文件、预览、传输、终端和 Git 运行在远程主机，本地工作区保持原行为。",
  "author": "zijun-T (https://github.com/zijun-T)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zijun-T/dsh-sidebar-remote.git"
  },
  "homepage": "https://github.com/zijun-T/dsh-sidebar-remote#readme",
  "bugs": {
    "url": "https://github.com/zijun-T/dsh-sidebar-remote/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "sidebar",
    "ssh",
    "remote",
    "sftp",
    "terminal",
    "xterm",
    "git"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./lib/client.js"
  ],
  "files": [
    "lib/",
    "src/",
    "scripts/",
    "test/",
    "docs/",
    "tsconfig.json",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "verify": "npm run typecheck && npm run test && npm run build",
    "verify:live": "node scripts/verify-live.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "diff": "^9.0.0",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@dsh-ssh/dsh-ssh": "0.1.3",
    "dsh-better-sidebar": "0.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT"
}